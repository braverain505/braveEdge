# Copy this file to `.env` and fill in what you need.
# Everything here is optional — the site builds and works with no .env at all.

# The deployed domain. Used for canonical URLs, og:url and sitemap.xml.
# Set this once the real domain is live; the default is company.url in
# src/data/site.js.
# VITE_SITE_URL=https://flintwire.com

# ---------------------------------------------------------------------------
# Analytics (off by default)
# ---------------------------------------------------------------------------
# 'simple' injects the Simple Analytics script. It identifies your site by
# hostname, so no key or token is required — just add the domain in their
# dashboard after deploying.
# VITE_ANALYTICS_PROVIDER=simple

# For any other provider (Plausible, Fathom, Umami, Google Analytics...), paste
# the script URL from that provider's dashboard.
# VITE_ANALYTICS_SCRIPT_SRC=

# Optional data-domain attribute, used by Plausible and Umami.
# VITE_ANALYTICS_DOMAIN=

# ---------------------------------------------------------------------------
# Contact form (optional)
# ---------------------------------------------------------------------------
# Where contact form submissions are POSTed as JSON.
# Leave unset to fall back to opening the visitor's email client.
# VITE_CONTACT_ENDPOINT=https://your-form-endpoint.example/submit
